    # Partial compliance
    No.PscheVst  =  sum(scheduledVst == "P", na.rm = TRUE)
    
  ) %>% 
  
  mutate(
    # Numeric indicators first
    Pct_scheVst_num  = round((No.CscheVst / No.sites) * 100, 0),
    
    # weighted only when partial exists
    
    Weighted_Score_num  = ifelse(
      No.PscheVst > 0, 
      round(
      ((No.CscheVst + (0.5 * No.PscheVst)) / No.sites) * 100, 0
      ), NA),
    
    # Formatted display
    `%age of sites with complete complaince`  = paste0(Pct_scheVst_num, "% (", No.CscheVst,"/",No.sites,")"),
    
    # only if partial exists
    
    `Status resulting from observed partial performance`  = ifelse(
      No.PscheVst > 0,
      paste0(
        Weighted_Score_num, "% (", 
        round(No.CscheVst + (0.5 * No.PscheVst),1), "/", No.sites, ")"
      ),
      "NA"
    ),
    # Interpretation
    Interpretation = case_when(
      Pct_scheVst_num  == 0 ~ "No lab met the target",
      Pct_scheVst_num  == 100 ~ "All labs met target",
      No.PscheVst == 0 & Pct_scheVst_num  < 100 ~ "Address the non-performing site(s)",
      No.PscheVst > 0 ~ "Partial performance observed – address the site(s)",
    )) %>% 
    mutate(
      Indicator  =  "%age of labs visited by sample transporter as scheduled",
      # Flag: Number with Partial responses
      Partial_Status_Observed = ifelse(No.PscheVst > 0, "Yes", "No")
    ) %>% 
  select(
    RRH,  Indicator, `%age of sites with complete complaince`, Partial_Status_Observed,  `Status resulting from observed partial performance`, Interpretation    
