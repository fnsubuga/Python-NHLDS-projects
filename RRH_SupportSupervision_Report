#### Report - test menu by RRH ####
RRHfacTestM  <-  serDel %>% 
  rename("TestMenu" = "The facility is performing all tests as defined by the National Test Menu for the health level, and/or, as identified for targeted interventions (e.g. POC, AHD tests)") %>% 
  filter(Yr == "2026") %>% 
  group_by(RRH) %>% 
  summarise(
    No.sites   =  n_distinct(HFacility),
    
    # Complete compliance
    No.CTMenu  =  sum(TestMenu == "Y", na.rm = TRUE),
    
    # Partial compliance
    No.PTMenu  =  sum(TestMenu == "P", na.rm = TRUE)
    
  ) %>% 
  
  mutate(
    # Numeric indicators first
    Pct_CTMenu  = round((No.CTMenu / No.sites) * 100, 0),
    
    # weighted only when partial exists
    
    Weighted_Score_num  = ifelse(
      No.PTMenu > 0, 
      round(
        ((No.CTMenu + (0.5 * No.PTMenu)) / No.sites) * 100, 0
      ), NA),
    
    # Formatted display
    `%age of sites with complete complaince`  = paste0(Pct_CTMenu, "% (", No.CTMenu,"/",No.sites,")"),
    
    # only if partial exists
    
    `Status resulting from observed partial performance`  = ifelse(
      No.PTMenu > 0,
      paste0(
        Weighted_Score_num, "% (", 
        round(No.CTMenu + (0.5 * No.PTMenu),1), "/", No.sites, ")"
      ),
      "NA"
    ),
    # Interpretation
    Interpretation = case_when(
      Pct_CTMenu  == 0 ~ "No lab met the target",
      Pct_CTMenu  == 100 ~ "All labs met target",
      No.PTMenu == 0 & Pct_CTMenu  < 100 ~ "Address the non-performing site(s)",
      No.PTMenu > 0 ~ "Partial performance observed – address the site(s)",
      
    )) %>% 
  mutate(
    Indicator  =  "%age of labs implementing >85% of test menu",
    # Flag: Number with Partial responses
    Partial_Status_Observed = ifelse(No.PTMenu > 0, "Yes", "None")
  ) %>% 
  select(
    RRH,  Indicator, `%age of sites with complete complaince`, Partial_Status_Observed, `Status resulting from observed partial performance`, Interpretation    
  )

  
  
  
  
  
  
  group_by(RRH) %>% 
  summarise(
