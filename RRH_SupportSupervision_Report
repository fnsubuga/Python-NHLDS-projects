#### Define the inputs
clean_deadlines <- function(x, 
                            ref_date = Sys.Date(),
                            fy_start_month = 7,   # Uganda FY often starts July
                            fy_end_month   = 6,   # ends June
                            month_deadline = c("last_day", "first_day")) {
  
                  month_deadline <- match.arg(month_deadline)
  
# --- helper function ----
# String inputs : Takes an input, s and returns cleaned output
  fix_text <- function(s) {   
    s %>%     # take the string through multiple cleaning sessions 
      str_to_lower() %>%
      str_replace_all("\\s+", " ") %>% # Remove extra spaces (one or more), remain with single space
      str_trim() %>%
      # common noise words/punctuation
      str_replace_all("[,\\.]+", " ") %>%       # remove punctuation noise, e.g., ",", "."
      str_replace_all("\\(.*?\\)", " ") %>%     # removes anything inside parentheses. ("6 months (June 2025)" → "6 months")
      str_replace_all("^by\\s+", "") %>%        # remove leading "By "
      str_replace_all("end of\\s+", "end ") %>%
      # fix common typos / OCR-ish errors
      str_replace_all(c(
        "ausust" = "august",
        "s0th"   = "30th",       # S0TH SEPT 2025
        "jun"    = "june",
        "sept"   = "september"
      )) %>%
      # remove ordinal suffixes: 15th -> 15
      str_replace_all("(?<=\\d)(st|nd|rd|th)", "") %>% # look-behind: “only match if preceded by a digit” - 15th Ausust 2025
      # normalize separators
      str_replace_all("[/\\-]", " ") %>% # replaces /, - 
      str_replace_all("\\s+", " ") %>%  #Earlier steps may introduce new spaces.: Collapse repeated spaces (again)
      str_trim()
  }
  
  parse_exact_date <- function(s) {    # a small helper function that is the “date interpreter” for anything that looks like a real calendar date.
    # tries many orders: "27/03/2025", "30 march 2025", "1 june 2026", etc.
    parse_date_time(   # a stronger version of as.Date
      s,
      orders = c("d m Y", "d b Y", "d B Y", "Y m d", "Y b d", "Y B d"), # try all orders until one works
      exact = FALSE,
      quiet = TRUE
    ) %>% as.Date()
  }
  
  parse_month_year <- function(s) {
    # e.g., "dec 2025", "june 2025", "september 2025"
    dt <- parse_date_time(s, orders = c("b Y", "B Y"), quiet = TRUE)
    if (is.na(dt)) return(as.Date(NA))
    d <- as.Date(dt)
    if (month_deadline == "first_day") return(floor_date(d, "month"))
    ceiling_date(d, "month") - days(1)  # last day of month
  }
  
  parse_duration <- function(s) {
    # number words -> digits
    s2 <- s %>%
      str_replace_all("\\bone\\b", "1") %>%
      str_replace_all("\\btwo\\b", "2") %>%
      str_replace_all("\\bthree\\b", "3") %>%
      str_replace_all("\\bfour\\b", "4") %>%
      str_replace_all("\\bsix\\b", "6")
    
    # months / years
    n <- suppressWarnings(as.integer(str_match(s2, "(\\d+)\\s*(month|months|year|years)")[,2]))
    unit <- str_match(s2, "(\\d+)\\s*(month|months|year|years)")[,3]
    
    if (is.na(n) || is.na(unit)) return(as.Date(NA))
    if (str_detect(unit, "year"))  return(as.Date(ref_date %m+% years(n)))
    if (str_detect(unit, "month")) return(as.Date(ref_date %m+% months(n)))
    as.Date(NA)
  }
  
  parse_fy <- function(s) {
    # "2025/2026 fy", "2025/26 fy", "2025 2026"
    m <- str_match(s, "(20\\d{2})\\s*(?:/|\\s)\\s*(\\d{2,4})")
    if (any(is.na(m))) return(as.Date(NA))
    
    y1 <- as.integer(m[,2])
    y2raw <- m[,3]
    y2 <- ifelse(nchar(y2raw) == 2, as.integer(paste0(substr(y1,1,2), y2raw)), as.integer(y2raw))
    
    # return FY end date (customizable)
    # FY ending month (e.g., June) -> end day of that month
    end_date <- as.Date(sprintf("%d-%02d-01", y2, fy_end_month)) %>%
      ceiling_date("month") %>%
      { . - days(1) } %>%
      as.Date()
  }
  
  parse_qtr <- function(s) {
    # "by end of qtr 2" / "end qtr 2"
    q <- suppressWarnings(as.integer(str_match(s, "qtr\\s*(\\d)")[,2]))
    if (is.na(q) || q < 1 || q > 4) return(as.Date(NA))
    
    # pick the next applicable fiscal-year quarter end from ref_date
    # Fiscal year starts fy_start_month
    y <- year(ref_date)
    fy_start <- as.Date(sprintf("%d-%02d-01", ifelse(month(ref_date) >= fy_start_month, y, y-1), fy_start_month))
    q_end <- fy_start %m+% months(3*q)  # start of next quarter
    q_end <- as.Date(q_end - days(1))   # end of quarter
    
    # if already past, move to next FY
    if (q_end < ref_date) {
      fy_start2 <- fy_start %m+% years(1)
      q_end <- as.Date((fy_start2 %m+% months(3*q)) - days(1))
    }
    q_end
  }
  
  is_status <- function(s) str_detect(s, "^(completed|ongoing|monthly|long term plan|immediate)") ||
    str_detect(s, "when .*available|based on availability")
  
  # --- main ----
  raw <- x
  txt <- fix_text(x)
  
  # classify
  type <- case_when(
    is.na(raw) ~ "missing",
    is_status(txt) ~ "status_or_condition",
    str_detect(txt, "^\\d{1,2}\\s+[a-z]+\\s+20\\d{2}$") ~ "exact_date",
    str_detect(txt, "^20\\d{2}\\s+\\d{1,2}\\s+\\d{1,2}$") ~ "exact_date",
    str_detect(txt, "^(jan|january|feb|february|mar|march|apr|april|may|jun|june|jul|july|aug|august|sep|september|oct|october|nov|november|dec|december)\\s+20\\d{2}$") ~ "month_year",
    str_detect(txt, "qtr\\s*[1-4]") ~ "quarter",
    str_detect(txt, "20\\d{2}\\s*(/|\\s)\\s*\\d{2,4}\\s*(fy)?") ~ "fiscal_year",
    str_detect(txt, "\\b(\\d+|one|two|three|four|six)\\s*(month|months|year|years)\\b") ~ "duration",
    TRUE ~ "other_text"
  )
  
  # parse to due_date
  due_date <- case_when(
    type == "exact_date" ~ parse_exact_date(txt),
    type == "month_year" ~ parse_month_year(txt),
    type == "duration" ~ parse_duration(txt),
    type == "fiscal_year" ~ parse_fy(txt),
    type == "quarter" ~ parse_qtr(txt),
    TRUE ~ as.Date(NA)
  )
  
  # flag invalid calendar dates (e.g., "30 feb 2025" will become NA but we can mark it)
  invalid_date_flag <- type %in% c("exact_date") & is.na(due_date) & !is.na(raw)
  
  tibble(
    raw = raw,
    cleaned_text = txt,
    type = type,
    due_date = due_date,
    invalid_date_flag = invalid_date_flag
  )
}

