  ) %>% 
  bind_rows(
    tibble(
      RRH   =  "NATIONAL",
      `No.sites_allTestMenu`    =  sum(.$`No.sites_allTestMenu`)
    )) %>% 
  left_join(sitesDash, by = "RRH") %>% 
